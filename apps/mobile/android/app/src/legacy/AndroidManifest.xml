<?xml version="1.0" encoding="utf-8"?>
<!--
    The pre-Play build only. It restores the floating microphone, the Quick Settings pause tile,
    and the narrow accessibility service that inserts text while a non-Odicto keyboard is active.
    The published store flavor deliberately omits all three: an overlay drawn over an app and an
    enabled accessibility service are both signals protected apps refuse, and neither is needed
    once the Odicto IME itself owns the editor.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="merge" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="merge" />

    <application>

        <service
            android:name=".overlay.VoiceOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:node="merge">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating voice-typing control shown over other apps' text fields while the user has enabled it" />
        </service>

        <service
            android:name=".overlay.PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/pause_tile_active"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".accessibility.OdictoAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/odicto_accessibility_service" />
        </service>

    </application>
</manifest>
