<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLightStatusBar">@bool/odicto_light_bars</item>
        <item name="android:statusBarColor">@color/odicto_canvas</item>
        <item name="android:navigationBarColor">@color/odicto_canvas</item>
        <!-- The pages choose their own light or dark theme; the system must not darken a light page. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>


    <!-- Keyboard window. The system reads these when it creates the IME window: without them it
         paints the keyboard's navigation strip black under the graphite keyboard. -->
    <style name="OdictoImeTheme" parent="@android:style/Theme.DeviceDefault.InputMethod">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/odicto_keyboard_background</item>
    </style>

    <!-- The launch screen follows the phone's day/night (the in-app choice is not known yet): canvas colour
         with the logo mark, both from colour resources. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/odicto_canvas</item>
        <item name="android:background">@drawable/odicto_splash</item>
    </style>
</resources>
