<?xml version="1.0" encoding="utf-8"?>
<!-- Key surface matching the existing Odicto keyboard palette. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#303438" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#4A5055" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#212326" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#282B2E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#282B2E" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#3B4044" />
        </shape>
    </item>
</selector>
