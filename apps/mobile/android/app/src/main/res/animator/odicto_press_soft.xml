<?xml version="1.0" encoding="utf-8"?>
<!-- Wide controls (a pill, a card): the same press, but barely, so a large surface never looks like it jumps. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType"
                android:duration="90" android:interpolator="@interpolator/odicto_smooth_out" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType"
                android:duration="90" android:interpolator="@interpolator/odicto_smooth_out" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType"
                android:duration="260" android:interpolator="@interpolator/odicto_bounce" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType"
                android:duration="260" android:interpolator="@interpolator/odicto_bounce" />
        </set>
    </item>
</selector>